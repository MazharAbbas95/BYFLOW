# --- App ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# --- Database ---
# For SQLite (default zero-friction setup):
DATABASE_URL=file:./dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/bayflow

# --- Auth ---
JWT_SECRET=bayflow-hackathon-super-secret-jwt-token-key-2026
JWT_EXPIRES_IN=7d

# --- Email (optional) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Bonus: calling / AI (leave blank if not used) ---
CALL_PROVIDER_API_KEY=
LLM_API_KEY=
STT_TTS_API_KEY=
